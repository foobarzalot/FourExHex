<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <!--
      Keep the test project's sources AND the Godot-free model library's
      sources out of the main game assembly. The src/** exclude is
      mandatory: without it the Godot SDK glob would also compile the
      moved sources into FourExHex.dll, duplicating every model type
      (CS0436) since the library already defines them. tools/** likewise
      keeps the level-designer CLI's Program out of the game assembly.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**/*;src/**/*;tools/**/*</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Logging is compiled in for EVERY configuration, shipping included: a
    release build's log is the only diagnostic a player's bug report can
    carry. This assembly compiles all of scripts/, which holds the bulk of
    the call sites, so omitting the define here would leave the largest
    slice of the log stripped from exported builds. Deliberately its own
    constant rather than DEBUG, which also gates the #if DEBUG CheatMenu
    hooks in these same scene scripts — tying them together would mean
    shipping a cheat menu to get a log. See Log.cs.
  -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);FOUREXHEX_LOGGING</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="src\FourExHex.Model\FourExHex.Model.csproj" />
    <ProjectReference Include="src\FourExHex.Controller\FourExHex.Controller.csproj" />
    <ProjectReference Include="src\FourExHex.ViewMath\FourExHex.ViewMath.csproj" />
  </ItemGroup>
</Project>
