# Godot 4+ specific ignores
.godot/
/android/

# .NET / C# build artifacts
.mono/
bin/
obj/
*.user
# Vendored godot-share AARs (no local build script, unlike rotationfix)
!addons/SharePlugin/bin/

# Godot export output
build/*
!build/.gdignore

# Test output / coverage
TestResults/

# System files
.DS_Store
Thumbs.db

# IDE
.vs/
.idea/
.vscode/
*.swp
.claude/*
!.claude/commands/

# Python venvs (e.g. for tools/build_icon.py)
.venv*/
